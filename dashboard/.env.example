# Public validator origin used for REST reads, SSE, and transaction broadcast.
EPDN_API_BASE_URL=http://127.0.0.1:8080
EPDN_CHAIN_ID=epdn-local-testnet-v1

# Optional server-only bearer credential for validator admin commands.
# Never prefix this key with NEXT_PUBLIC_ and never store it in browser storage.
EPDN_ADMIN_API_TOKEN=
